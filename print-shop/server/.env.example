PORT=4000
CLIENT_URL=http://localhost:5174
DB_PATH=./db/print_shop.sqlite

# Both are required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Used once, when the database is first created
ADMIN_EMAIL=owner@printshop.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Shop Owner
