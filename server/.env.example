PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/hm_virtual_services
JWT_SECRET=your_very_long_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_very_long_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
UPLOAD_PATH=../uploads

# Optional: override default admin password on first run
# ADMIN_PASSWORD=Password123

# QuickBooks Online (optional)
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox
# QBO_REDIRECT_URI=http://localhost:5000/api/integrations/qbo/callback
