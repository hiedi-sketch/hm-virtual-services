// src/pages/types.ts

// Task type
export type Task = {
  id: string;
  title: string;
  due_date?: string;
  assigned_to?: string;
  completed: boolean;
  progress: "not_started" | "in_progress" | "completed";
  recurrence: "none" | "daily" | "weekly" | "monthly";
  subtasks?: Task[];
};

// Status dropdown badge classes
export const statusBadge = (status: Task["progress"]) => {
  switch (status) {
    case "not_started":
      return "border border-gray-300 text-gray-700 rounded px-2 py-1 text-xs";
    case "in_progress":
      return "border border-blue-400 bg-blue-100 text-blue-800 rounded px-2 py-1 text-xs";
    case "completed":
      return "border border-green-400 bg-green-100 text-green-800 rounded px-2 py-1 text-xs";
    default:
      return "";
  }
};

// Recurrence badge classes
export const recurrenceBadge = (recurrence: Task["recurrence"]) => {
  switch (recurrence) {
    case "daily":
      return "bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-xs font-semibold";
    case "weekly":
      return "bg-indigo-100 text-indigo-800 px-2 py-1 rounded text-xs font-semibold";
    case "monthly":
      return "bg-purple-100 text-purple-800 px-2 py-1 rounded text-xs font-semibold";
    default:
      return "bg-gray-100 text-gray-600 px-2 py-1 rounded text-xs";
  }
};
